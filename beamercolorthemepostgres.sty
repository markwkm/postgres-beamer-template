% Colors are defined from http://wiki.postgresql.org/wiki/Color_Palette

\mode<presentation>

\definecolor{pgdarkblue}{HTML}{0064a5}
\definecolor{pgbaseblue}{HTML}{336791}
\definecolor{pglightblue}{HTML}{008bb9}
\definecolor{how2026}{HTML}{11044a}

\definecolor{pgdarkgrey}{HTML}{585858}
\definecolor{pgbasegrey}{HTML}{666666}
\definecolor{pglightgrey}{HTML}{848484}

\definecolor{pgdarkorange}{HTML}{cc3b03}
\definecolor{pgbaseorange}{HTML}{d24b03}
\definecolor{pglightorange}{HTML}{F26522}

% Alerted and example text colors.  They are not in the PostgreSQL palette.
% Each has a contrast ratio of at least 4.5:1 against the base blue.
\definecolor{pgalert}{HTML}{FFE082}
\definecolor{pgexample}{HTML}{B9F6CA}

\setbeamercolor{structure}{fg=white}
\setbeamercolor{alerted text}{fg=pgalert}
\setbeamercolor{example text}{fg=pgexample}
\setbeamercolor{normal text}{fg=white,bg=pgbaseblue}
\setbeamercolor{titlelike}{fg=white,bg=}

\setbeamercolor{author in head/foot}{fg=white}
\setbeamercolor{title in head/foot}{fg=white}
\setbeamercolor{date in head/foot}{fg=white}

\mode
<all>
